                  "children": [
                    {
                      "type": "text",
                      "content": "Antônio Mello",
                      "x": 20,
                      "y": 46.5,
                      "textGrowth": "fixed-width",
                      "width": 184.67,
                      "fontFamily": "Satoshi",
                      "fontSize": 28,
                      "fill": "#171f38",
                      "fontWeight": "800",
                      "lineHeight": 1,
                      "id": "98PLq"
                    },
                    {
                      "type": "text",
                      "content": "CEO",
                      "x": 20,
                      "y": 85.5,
                      "textGrowth": "fixed-width",
                      "width": 43.75,
                      "fontFamily": "Satoshi",
                      "fontSize": 20,
                      "fill": "#b08961",
                      "fontWeight": "700",
                      "lineHeight": 1.5,
                      "id": "pEXir"
                    },
                    {
                      "type": "text",
                      "content": "Buscamos no mercado a melhor consultoria para reestruturar a equipe da Medicalway e chegamos na DNA de Vendas. Fez todo um trabalho de reestruturação de pessoas, de sistema, de treinamentos gerenciais. A gente já teve um aumento de 30% no faturamento mas também teremos um crescimento a longo prazo, onde planejamos crescer 6x o faturamento atual. Nossa equipe é mais agressiva, mais controlada com dados, mais produtiva e com mais satisfação profissional.",
                      "x": 20,
                      "y": 135.5,
                      "textGrowth": "fixed-width",
                      "width": 743,
                      "fontFamily": "Satoshi",
                      "fontSize": 18,
                      "fill": "#171f38",
                      "lineHeight": 1.5,
                      "textAlign": "justify",
                      "id": "xogVP"
                    }
                  ],
                  "id": "d8rFw"
                }
              ],
              "id": "TXxQL"
            },
            {
              "type": "frame",
              "name": "div",
              "x": 982,
              "y": 568,
              "width": 989,
              "height": 343,
              "layout": "none",
