{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pena",
  "version": "0.1.0",
  "identifier": "dev.pena.app",
  "build": {
    "frontendDist": "../public",
    "beforeDevCommand": "bun run sidecar",
    "beforeBuildCommand": "bun run sidecar"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": ["../build/icon.png", "../build/icon.icns", "../build/icon.ico"],
    "copyright": "Pena",
    "externalBin": ["binaries/pena-server"],
    "resources": {
      "../public/": "public/",
      "../skills/": "skills/",
      "../node_modules/canvaskit-wasm/bin/canvaskit.js": "node_modules/canvaskit-wasm/bin/canvaskit.js",
      "../node_modules/canvaskit-wasm/bin/canvaskit.wasm": "node_modules/canvaskit-wasm/bin/canvaskit.wasm",
      "../node_modules/lucide-static/icons/": "node_modules/lucide-static/icons/",
      "../node_modules/feather-icons/dist/icons/": "node_modules/feather-icons/dist/icons/",
      "../node_modules/@phosphor-icons/core/assets/regular/": "node_modules/@phosphor-icons/core/assets/regular/",
      "../node_modules/@material-symbols/svg-400/outlined/": "node_modules/@material-symbols/svg-400/outlined/",
      "../node_modules/@material-symbols/svg-400/rounded/": "node_modules/@material-symbols/svg-400/rounded/",
      "../node_modules/@material-symbols/svg-400/sharp/": "node_modules/@material-symbols/svg-400/sharp/"
    },
    "fileAssociations": [
      { "ext": ["pen"], "name": "Pen design", "role": "Editor", "rank": "Alternate" }
    ],
    "macOS": { "minimumSystemVersion": "14.0", "signingIdentity": "-", "entitlements": "Entitlements.plist" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBQzlGNDI4OEYzNjdEMUIKUldRYmZUYVBLUFRKT2piNitPRzc0blJVb0RUOUI2bmdjdlZ0bFdJRTQ4QVplWlAwRFBlSHZSZzMK",
      "endpoints": ["https://github.com/guiibraun/pena/releases/latest/download/latest.json"]
    }
  }
}
