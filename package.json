{
  "name": "pena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Editor de design com agente (inspirado no pen.dev) usando suas assinaturas Claude/ChatGPT",
  "scripts": {
    "start": "bun server.mjs",
    "app": "tauri dev",
    "sidecar": "bun scripts/sidecar.mjs",
    "test": "bun scene.test.mjs && bun shader.test.mjs && bun doc.test.mjs && bun figma.test.mjs && bun browser-import.test.mjs && bun compat.test.mjs",
    "package": "tauri build",
    "install-app": "bun run package && rm -rf /Applications/Pena.app && cp -R src-tauri/target/release/bundle/macos/Pena.app /Applications/"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.301",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openai/codex-sdk": "^0.163.0",
    "canvaskit-wasm": "^0.42.0",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "kiwi-schema": "^0.5.0",
    "yaml": "^2.9.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "ajv": "^8.20.0"
  },
  "productName": "Pena"
}
